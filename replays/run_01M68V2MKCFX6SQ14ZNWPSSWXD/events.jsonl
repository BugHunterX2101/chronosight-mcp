{"v":1,"seq":44,"sessionId":"ses_01M68V2MJB0TTFS7SFQ0WX85P4","runId":"run_01M68V2MKCFX6SQ14ZNWPSSWXD","ts":"2026-10-31T11:25:53.543Z","type":"patch.diff","replay":false,"data":{"patchId":"pat_01M68V7CHPEXGC4XX171QXKQN9","candidate":1,"model":"muse-spark-1.3-contributor","unifiedDiff":"diff --git a/controller.py b/controller.py\nindex b378adc..db2adc4 100644\n--- a/controller.py\n+++ b/controller.py\n@@ -1,7 +1,7 @@\n-\"\"\"Elbow joint PD controller, as shipped (faulted baseline).\"\"\"\n+\"\"\"Elbow joint PD controller with EncoderX-14 handling.\"\"\"\n import math\n \n-from abi import Command, State\n+from abi import REG_CONF2, STATUS_RST, Command, State\n \n \n class Controller:\n@@ -10,11 +10,19 @@ class Controller:\n         self.kd = float(params[\"KD\"])\n         self.angle_lpf_hz = float(params[\"ANGLE_LPF_HZ\"])\n         self.deriv_lpf_hz = float(params[\"DERIV_LPF_HZ\"])\n+        self.enc_filt = int(params[\"ENC_FILT\"])\n         self.q_f = None\n         self.q_prev = None\n         self.dq_f = 0.0\n+        self.last_u = 0.0\n \n     def step(self, state: State, dt: float) -> Command:\n+        writes = [(REG_CONF2, self.enc_filt)]\n+        # STATUS is read together with angle every cycle; hold last\n+        # command while flags show invalid (reset / field invalid).\n+        if state.enc_status != 0:\n+            return Command(u=self.last_u, reg_writes=list(writes))\n+\n         a_q = 1.0 - math.exp(-2.0 * math.pi * self.angle_lpf_hz * dt)\n         a_d = 1.0 - math.exp(-2.0 * math.pi * self.deriv_lpf_hz * dt)\n \n@@ -25,4 +33,6 @@ class Controller:\n         self.dq_f += a_d * (dq - self.dq_f)\n \n         u = self.kp * (state.q_ref - self.q_f) + self.kd * (state.qd_ref - self.dq_f)\n-        return Command(u=max(-1.0, min(1.0, u)))\n+        u = max(-1.0, min(1.0, u))\n+        self.last_u = u\n+        return Command(u=u, reg_writes=list(writes))\ndiff --git a/params.py b/params.py\nindex 9ddded9..9d9c2ea 100644\n--- a/params.py\n+++ b/params.py\n@@ -1,7 +1,8 @@\n # S1 elbow joint controller parameters (units: duty/rad, duty·s/rad, Hz)\n PARAMS = {\n-    \"KP\": 3.2,\n-    \"KD\": 0.0035,\n-    \"ANGLE_LPF_HZ\": 200.0,\n-    \"DERIV_LPF_HZ\": 30.0,\n+    \"KP\": 6.0,\n+    \"KD\": 0.25,\n+    \"ANGLE_LPF_HZ\": 60.0,\n+    \"DERIV_LPF_HZ\": 40.0,\n+    \"ENC_FILT\": 3,\n }\n","diffHash":"sha256:2d19a285d82771b342054db52034a59142fa484d9f957227db813cb81da51f1c","boundsCheck":{"ok":true,"code":null,"details":[]}}}
