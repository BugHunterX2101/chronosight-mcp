FROM node:24-bookworm-slim
WORKDIR /app
COPY . .
RUN npm ci --omit=dev --no-audit --no-fund
RUN useradd --create-home --uid 10001 chronosight && mkdir -p /app/data /run/launcher && chown -R chronosight:chronosight /app /run/launcher
USER chronosight
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8080 DATA_DIR=/app/data
EXPOSE 8080
CMD ["node", "--env-file-if-exists=.env.local", "services/gateway/src/server.ts"]
