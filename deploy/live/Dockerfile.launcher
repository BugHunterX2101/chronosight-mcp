FROM node:24-bookworm-slim
WORKDIR /app
COPY . .
RUN npm ci --omit=dev --no-audit --no-fund
RUN useradd --create-home --uid 10001 chronosight && mkdir -p /run/launcher && chown -R chronosight:chronosight /app /run/launcher
USER chronosight
ENV NODE_ENV=production LAUNCHER_SOCKET=/run/launcher/launcher.sock
EXPOSE 8080
CMD ["node", "services/sandbox-launcher/src/server.ts"]
