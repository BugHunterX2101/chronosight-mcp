{
  "name": "chronosight",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "workspaces": ["packages/*", "services/gateway", "services/sandbox-launcher", "services/media-worker", "apps/web"],
  "scripts": {
    "typecheck": "tsc -p packages/run-model && tsc -p services/gateway && tsc -p services/sandbox-launcher && tsc -p services/media-worker && npm run typecheck -w apps/web",
    "test": "vitest run",
    "dev:gateway": "npm run dev -w services/gateway",
    "dev:web": "npm run dev -w apps/web",
    "corpus:check": "python tools/py/build_corpus.py --check"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "typescript": "~6.0.3",
    "vitest": "~5.0.5"
  }
}
